# Пустые значения используют значения приложения по умолчанию.
# HSE_DEMO_MODE: true — учебные примеры, false — пустой экран до подключения источников.
HSE_DEMO_MODE=
HSE_TIMEZONE=
# PostgreSQL URL; без него сайт и демонстрационные данные работают как раньше.
HSE_DATABASE_URL=
HSE_DB_POOL_SIZE=
HSE_DB_CONNECT_TIMEOUT=
# Только для локального сервиса db в compose.db.yaml; пароль задайте в своём .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
# Только отдельная тестовая БД. Для обычного запуска не требуется.
HSE_TEST_DATABASE_URL=
# Зарезервировано для будущего серверного модуля агента. Сейчас API модели не вызывается.
OPENAI_API_KEY=
OPENAI_MODEL=
# Docker Compose; POSTGRES_PASSWORD обязателен, генерируется deploy/prepare.sh на сервере.
HSE_BIND_HOST=
HSE_PORT=
