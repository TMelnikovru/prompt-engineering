{
  "openapi": "3.1.0",
  "info": {
    "title": "HSE Study Agent",
    "description": "Контракт для разработки сайта учебного агента. Живые интеграции, LLM и фоновые напоминания пока не реализованы.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/dashboard": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Задания, план дня и состояния источников",
        "description": "Каркас API для фронтенда. По умолчанию возвращает явно помеченные учебные примеры. При HSE_DEMO_MODE=false возвращает пустые данные и mode=unconfigured. scenario=empty и scenario=error доступны только в демо-режиме.",
        "operationId": "dashboard_api_v1_dashboard_get",
        "parameters": [
          {
            "name": "scenario",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PreviewScenario",
              "default": "default"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "400": {
            "description": "Сценарий примера отключён",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Сценарий ошибки для разработки интерфейса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Проверка HTTP-приложения",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ApiError"
      },
      "ApiErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorDetail"
      },
      "Dashboard": {
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/DashboardMeta"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array",
            "title": "Tasks"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "plan": {
            "$ref": "#/components/schemas/DayPlan"
          }
        },
        "type": "object",
        "required": [
          "meta",
          "tasks",
          "sources",
          "plan"
        ],
        "title": "Dashboard"
      },
      "DashboardMeta": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "unconfigured",
              "live"
            ],
            "title": "Mode"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "generated_at",
          "timezone",
          "notice"
        ],
        "title": "DashboardMeta"
      },
      "DayPlan": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "available_minutes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Available Minutes"
          },
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/PlanBlock"
            },
            "type": "array",
            "title": "Blocks"
          },
          "unscheduled_task_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unscheduled Task Ids"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "date",
          "available_minutes",
          "note"
        ],
        "title": "DayPlan"
      },
      "Evidence": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "title",
          "quote"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlanBlock": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "minutes": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Minutes"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "starts_at",
          "minutes",
          "reason"
        ],
        "title": "PlanBlock"
      },
      "PreviewScenario": {
        "type": "string",
        "enum": [
          "default",
          "empty",
          "error"
        ],
        "title": "PreviewScenario"
      },
      "Source": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_connected",
              "connected",
              "syncing",
              "error",
              "stale"
            ],
            "title": "Status"
          },
          "last_synced_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Synced At"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "status"
        ],
        "title": "Source"
      },
      "Task": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "course": {
            "type": "string",
            "title": "Course"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "done"
            ],
            "title": "Status",
            "default": "todo"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Priority"
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due At",
            "description": "Точный срок с часовым поясом, только если он известен."
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date",
            "description": "Срок без известного времени. Не заменяется на 23:59."
          },
          "estimated_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Minutes"
          },
          "materials": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Materials"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "course",
          "priority",
          "evidence"
        ],
        "title": "Task"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
